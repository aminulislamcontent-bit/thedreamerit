# ---- Core ----
# Absolute or relative path to the SQLite database file (created by migrations).
DATABASE_PATH=./data/app.db
# Public base URL used for canonical URLs, sitemap and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret used only to derive server-side integrity tokens. Generate with: openssl rand -hex 32
APP_SECRET=replace-with-a-random-32-byte-hex-string
# Business display mode: "live" hides unpublished/demo records from the public site.
CATALOGUE_MODE=live

# ---- Optional external integrations (all disabled until credentials exist) ----
# AI Content Studio. When unset, drafts are produced by the local, verified-field-only
# template engine and are labelled "template". No content is generated from invented facts.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
# Social publishing (official platform APIs only)
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_BUSINESS_TOKEN=
YOUTUBE_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
# Payments / messaging / analytics / Search Console
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
SMTP_URL=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
GA_MEASUREMENT_ID=
